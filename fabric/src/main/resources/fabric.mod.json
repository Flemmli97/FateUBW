{
  "schemaVersion": 1,
  "id": "fateubw",
  "version": "${version}",
  "name": "FateUBW",
  "description": "The Holy Grail War! Brought to minecraft",
  "authors": [
    "Flemmli97"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "https://github.com/Flemmli97/FateUBW/issues",
    "sources": "https://github.com/Flemmli97/FateUBW"
  },
  "license": "ARR",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.flemmli97.fateubw.fabric.FateUBWFabric"
    ],
    "tenshilib_client": [
      "io.github.flemmli97.fateubw.fabric.client.FateUBWFabricClient"
    ],
    "modmenu": [
      "io.github.flemmli97.fateubw.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "fateubw.mixins.json",
    "fateubw.fabric.mixins.json"
  ],
  "depends": {
    "fabric": ">=${fabric_version}",
    "minecraft": ">=${mcversion}",
    "tenshilib": ">=${tenshilib_version}",
    "forgeconfigapiport": ">=${forge_config_api}",
    "smartbrainlib": ">=${sbl_version}"
  }
}